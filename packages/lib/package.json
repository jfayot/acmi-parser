{
  "name": "acmi-parser",
  "version": "1.2.1",
  "description": "ACMI file format parser",
  "author": "jfayot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfayot/acmi-parser.git"
  },
  "keywords": [
    "ACMI",
    "Tacview",
    "parser",
    "cesium"
  ],
  "homepage": "https://github.com/jfayot/acmi-parser",
  "bugs": "https://github.com/jfayot/acmi-parser/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/acmi-parser.cjs",
  "module": "./dist/acmi-parser.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "import": "./dist/acmi-parser.js",
    "require": "./dist/acmi-parser.cjs"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepack": "node scripts/package-readme.mjs create",
    "postpack": "node scripts/package-readme.mjs clean",
    "clean": "rimraf dist",
    "clean:all": "pnpm clean && rimraf node_modules",
    "release": "pnpm build && npm publish"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.61",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
